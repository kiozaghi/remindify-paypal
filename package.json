{
  "name": "remindify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Remindify — the autonomy layer for everything that comes back.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "mcp": "node mcp/server.mjs",
    "contracts:compile": "node contracts/compile.mjs",
    "contracts:deploy": "node contracts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "solc": "^0.8.24",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "solc": {
      "tmp": "^0.2.5"
    }
  }
}
