{
  "name": "remindify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Remindify — the autonomy layer for everything that comes back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiozaghi/remindify-paypal"
  },
  "homepage": "https://remindify-paypal.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/seo.mjs",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "mcp": "node mcp/server.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run build",
    "test": "node --test test/*.test.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "seo": "node scripts/seo.mjs"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "dotenv": "^18.0.9",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
