{
  "name": "remindify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Remindify — the autonomy layer for everything that comes back.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/seo.mjs",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "mcp": "node mcp/server.mjs",
    "contracts:compile": "node contracts/compile.mjs",
    "contracts:deploy": "node contracts/deploy.mjs",
    "chain:rehearse": "node scripts/rehearse-chain.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run build",
    "test": "node --test test/*.test.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "seo": "node scripts/seo.mjs"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "solc": "^0.8.24",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "solc": {
      "tmp": "^0.2.5"
    }
  }
}
