# Remindify environment
# Copy to .env for local runs. Never commit real secrets.

# --- Server ---------------------------------------------------------------
PORT=4178

# --- Database -------------------------------------------------------------
# Local development and Docker use SQLite at ./data/remindify.db.
# REMINDIFY_DATA_DIR=./data
# REMINDIFY_DB=./data/remindify.db
#
# Vercel has no persistent filesystem, so production must use Postgres.
# Set ONE of these to a Neon, Supabase or Vercel Postgres connection string.
# When present, SQLite is ignored and the server uses the Postgres store.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_PRISMA_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://user:password@host/db?sslmode=require
#
# Set to false only for a local Postgres without TLS. Vercel/Neon use TLS.
# DATABASE_SSL=false
# PG_POOL_MAX=2
# PG_NO_LOCK=1 disables the workspace advisory lock; use it only in tests.
# PG_NO_LOCK=1

# The canonical public origin. Used in Google OAuth redirects and the wallet
# sign-in message. Set this to the real https URL in production.
PUBLIC_ORIGIN=http://localhost:4178

# Force Secure cookies. If omitted, Secure is inferred from x-forwarded-proto.
# Set COOKIE_SECURE=true behind HTTPS; set it to false only for local HTTP.
# COOKIE_SECURE=true

# --- Search and AI discovery ---------------------------------------------
# Build-time SEO values. PUBLIC_ORIGIN above sets canonicals, sitemap and JSON-LD.
# Verification values are optional and only emitted when set at build time.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# --- Google OAuth (optional) ---------------------------------------------
# Leave blank to disable Google sign-in; email and wallet still work.
# The redirect URI below must be registered exactly in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4178/api/auth/google/callback

# --- Billing (optional) ---------------------------------------------------
# Plans and usage metering work without a provider. Plan changes through the
# API stay disabled until a provider is connected, unless you opt in here for
# a demo or a manually invoiced deployment.
# BILLING_ALLOW_PLAN_SWITCH=1
# BILLING_MODE=demo
# STRIPE_SECRET_KEY=

# --- Execution connectors (optional) --------------------------------------
# Agents can only execute through an https endpoint you connect in their
# passport. No env vars are needed for that. These tune the dispatcher.
# EXECUTOR_TIMEOUT_MS=8000
# Allow http://localhost executor URLs. Local development and tests only.
# EXECUTOR_ALLOW_LOCAL=1

# --- Trust layer (optional) ----------------------------------------------
# Preview mode works without any chain configuration. Add these only after
# the contracts are deployed and verified.

# Base mainnet
# BASE_RPC_URL=https://mainnet.base.org
# BASE_ATTESTATION_CONTRACT=0x...
# BASE_ESCROW_CONTRACT=0x...

# Base Sepolia
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_SEPOLIA_ATTESTATION_CONTRACT=0x...
# BASE_SEPOLIA_ESCROW_CONTRACT=0x...

# Celo mainnet
# CELO_RPC_URL=https://forno.celo.org
# CELO_ATTESTATION_CONTRACT=0x...
# CELO_ESCROW_CONTRACT=0x...

# Celo Sepolia
# CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# CELO_SEPOLIA_ATTESTATION_CONTRACT=0x...
# CELO_SEPOLIA_ESCROW_CONTRACT=0x...
