# Remindify environment
# Copy to .env for local runs. Never commit real secrets.

# --- Server ---------------------------------------------------------------
PORT=4178

# SQLite location. Defaults to ./data/remindify.db.
# REMINDIFY_DATA_DIR=./data
# REMINDIFY_DB=./data/remindify.db

# The canonical public origin. Used in Google OAuth redirects and the wallet
# sign-in message. Set this to the real https URL in production.
PUBLIC_ORIGIN=http://localhost:4178

# Force Secure cookies. If omitted, Secure is inferred from x-forwarded-proto.
# Set COOKIE_SECURE=true behind HTTPS; set it to false only for local HTTP.
# COOKIE_SECURE=true

# --- Google OAuth (optional) ---------------------------------------------
# Leave blank to disable Google sign-in; email and wallet still work.
# The redirect URI below must be registered exactly in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4178/api/auth/google/callback

# --- Trust layer (optional) ----------------------------------------------
# Preview mode works without any chain configuration. Add these only after
# the contracts are deployed and verified.

# Base mainnet
# BASE_RPC_URL=https://mainnet.base.org
# BASE_ATTESTATION_CONTRACT=0x...
# BASE_ESCROW_CONTRACT=0x...

# Base Sepolia
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_SEPOLIA_ATTESTATION_CONTRACT=0x...
# BASE_SEPOLIA_ESCROW_CONTRACT=0x...

# Celo mainnet
# CELO_RPC_URL=https://forno.celo.org
# CELO_ATTESTATION_CONTRACT=0x...
# CELO_ESCROW_CONTRACT=0x...

# Celo Sepolia
# CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# CELO_SEPOLIA_ATTESTATION_CONTRACT=0x...
# CELO_SEPOLIA_ESCROW_CONTRACT=0x...
